TELEGRAM_BOT_TOKEN=

# http://ollama:11434 es el nombre del servicio dentro de docker-compose.
# Si corres el proyecto sin Docker (venv local), usa http://localhost:11434.
OLLAMA_HOST=http://ollama:11434

# qwen2.5:3b-instruct corre bien con ~4GB RAM libres; si tienes más RAM,
# llama3.1:8b-instruct-q4_K_M o qwen2.5:7b-instruct dan mejor calidad.
OLLAMA_CHAT_MODEL=qwen2.5:3b-instruct
OLLAMA_EMBED_MODEL=nomic-embed-text

# docker-compose sobreescribe estas dos rutas a /data/... (volumen
# persistente); estos valores solo aplican si corres sin Docker.
CHROMA_PERSIST_DIR=./chroma_data
MEMORY_DB_PATH=./memory.db
